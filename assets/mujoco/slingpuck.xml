<mujoco model="slingpuck_menagerie">
    <compiler angle="radian" meshdir="robotstudio_so101/assets" />
    <option gravity="0 0 -9.81" />
    
    <!-- 1. Include the SO-101 arm from the menagerie -->
    <!-- Change this path to point to your local menagerie xml -->
    <include file="assets/mujoco/robotstudio_so101/so101.xml"/>
    
    <asset>
        <material name="wood" rgba="0.8 0.6 0.4 1"/>
        <material name="puck_mat" rgba="0.2 0.2 0.2 1"/>
    </asset>

    <worldbody>
        <!-- Lighting -->
        <light pos="0 0 1" dir="0 0 -1" diffuse="1 1 1"/>
        
        <!-- 2. Shift the board forward by Y=0.20m so the gate aligns with the arm -->
        <body name="tabletop" pos="0 0.20 0">
            <!-- Board base -->
            <geom type="box" size="0.15 0.30 0.01" pos="0 0 -0.01" material="wood"/>
            
            <!-- Center Divider with Gate -->
            <geom type="box" size="0.0625 0.01 0.02" pos="-0.0875 0 0.02" material="wood"/>
            <geom type="box" size="0.0625 0.01 0.02" pos="0.0875 0 0.02" material="wood"/>
            
            <!-- Boundaries -->
            <geom type="box" size="0.16 0.01 0.05" pos="0 0.31 0.02" material="wood"/>
            <geom type="box" size="0.16 0.01 0.05" pos="0 -0.31 0.02" material="wood"/>
            <geom type="box" size="0.01 0.32 0.05" pos="-0.16 0 0.02" material="wood"/>
            <geom type="box" size="0.01 0.32 0.05" pos="0.16 0 0.02" material="wood"/>

            <!-- Puck (2D translational joints relative to the board) -->
            <body name="puck" pos="0 0.20 0.01">
                <joint name="puck_x" type="slide" axis="1 0 0"/>
                <joint name="puck_y" type="slide" axis="0 1 0"/>
                <geom type="cylinder" size="0.015 0.01" material="puck_mat" mass="0.01"/>
            </body>
        </body>
    </worldbody>
</mujoco>